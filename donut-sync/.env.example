# Generate with: openssl rand -hex 32
SYNC_TOKEN=CHANGE_ME_generate_a_long_random_secret

PORT=12342

# Bind to 127.0.0.1 when Caddy/Nginx runs on this host.
DONUT_SYNC_BIND=127.0.0.1

# Optional. Set to the externally reachable HTTPS origin when behind a proxy.
# Forwarded headers are used automatically when this is empty.
PUBLIC_URL=https://sync.example.com
